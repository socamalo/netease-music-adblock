#!name = 网易云音乐去广告 v1.0.4
#!desc = [v1.0.4] 屏蔽网易云音乐 App 的开屏/弹窗/信息流/评论区/侧栏广告与推广位。双层：URL Rewrite（免 MITM）+ Script（需 MITM）。仅去广告，不解锁 VIP。 / [v1.0.4] Removes NetEase Cloud Music ads. Two layers: URL Rewrite (no MITM needed) + Script (needs MITM). Ad removal only.
#!author = socamalo
#!homepage = https://github.com/socamalo/netease-music-adblock
#!icon = https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Netease_Music.png
#!url = https://raw.githubusercontent.com/socamalo/netease-music-adblock/main/netease-music-adblock.sgmodule
#!raw-url = https://raw.githubusercontent.com/socamalo/netease-music-adblock/main/netease-music-adblock.sgmodule
#!category = 去广告
#!date = 2026-10-15
#!version = 1.0.4


[Rule]
# 广告素材 CDN：这些域名只用于投放广告图片/视频，直接 REJECT 最省事。
# Ad-creative CDNs: only ever used to serve ad images/video, so reject outright.
#
# 注意 iadmusicmatvideo 必须单独列：它是「开屏动图/视频素材」，域名不以
# iadmusicmat.music.126.net 结尾，上一条 suffix 规则**盖不住它**。
# 开屏视频广告动辄几百 MB，就是从这里下的。
# iadmusicmatvideo must be listed separately: it hosts the splash-screen
# animated/video creative. It does NOT end with iadmusicmat.music.126.net, so
# the rule above does not cover it -- and splash video ads are hundreds of MB.
DOMAIN-SUFFIX, iadmusicmat.music.126.net, REJECT
DOMAIN-SUFFIX, iadmusicmatvideo.music.126.net, REJECT
DOMAIN-SUFFIX, admusicpic.music.126.net, REJECT
DOMAIN-SUFFIX, iadmat.nosdn.127.net, REJECT
DOMAIN-SUFFIX, iadmatapk.nosdn.127.net, REJECT
DOMAIN-SUFFIX, iad.g.163.com, REJECT

# 兜底：网易云广告素材主机一律以 iadmusicmat 开头，将来换域名也能盖住。
# Catch-all: NetEase ad-creative hosts are prefixed iadmusicmat, so a future
# subdomain is covered without waiting for a module update.
DOMAIN-KEYWORD, iadmusicmat, REJECT

# 第三方广告联盟：网易云部分开屏广告由外部广告 SDK 投放（如天猫双11 这类品牌单）。
# Third-party ad network: some splash ads are sold through an external SDK
# rather than NetEase's own inventory (brand campaigns such as Tmall 双11).
DOMAIN-SUFFIX, m.ads.8le8le.com, REJECT

# HTTPDNS：屏蔽后广告域名无法被解析绕过，同时不影响正常播放。
# HTTPDNS: blocking it stops ad domains being resolved around the rules.
DOMAIN-SUFFIX, httpdns.n.netease.com, REJECT
DOMAIN-SUFFIX, httpdns.music.163.com, REJECT


[URL Rewrite]
# ---------------------------------------------------------------- #
# 第一层：纯 URL 层的广告拦截，**不需要 MITM、不需要证书、不需要脚本**。
#
# 为什么要有这一层：脚本要生效，必须 MITM 解密成功；而 URL Rewrite 只看 URL，
# 证书没装好 / 解密没开也照样拦得住。实测日志里 REJECT-DICT 是确认生效的。
# 所以把「一望即知的广告接口」放这一层，脚本只留给需要改 JSON 的复杂场景。
#
# Layer 1: ad blocking at the pure URL level -- no MITM, no certificate, no
# script. Scripts only fire once MITM decryption works; URL rewrites match on
# the URL alone and keep working even when the certificate is not trusted.
# Splash/feed ad endpoints are one-liners, so they belong here.
#
# reject-dict returns {} -- the same payload the script would produce.
# ---------------------------------------------------------------- #

# 所有 /ad 系接口（开屏、嗅探、配置、素材、埋点）
# Every /ad/* endpoint: splash, sniffing, config, material, telemetry.
# 注意 [a-z]*api 同时覆盖 /api /eapi /xeapi /weapi —— 少一个前缀就整段失效。
^https?:\/\/(?:[\w-]+\.)?music\.163\.com\/[a-z]*api\/ad(?:\/|[?#]|$) - reject-dict

# 其余纯推广位 / Other pure-promo endpoints
^https?:\/\/(?:[\w-]+\.)?music\.163\.com\/[a-z]*api\/(?:delivery\/|resource-exposure\/|vip\/cashier\/|vipmall\/|sp\/flow\/popup\/|content\/activity\/|mlivestream\/entrance\/|activity\/bonus\/) - reject-dict


[Script]
# ---------------------------------------------------------------- #
# 所有接口都交给同一个脚本处理，脚本内部按路径决定「清空」还是「改写」。
# 这样新增/失效接口只需要改脚本，不用改模块。
#
# Every endpoint routes to the same script; the script decides per-path whether
# to blank the payload or surgically rewrite it. Adding or retiring an endpoint
# is then a script change, not a module change.
#
# binary-body-mode=1 是关键：网易云的 eapi 响应是 AES 加密的二进制流，
# 必须以字节而不是字符串交给脚本，否则密文会被 UTF-8 解码破坏。
# binary-body-mode=1 matters: NetEase eapi responses are AES-encrypted binary
# streams and must reach the script as bytes, not as a UTF-8-decoded string.
# ---------------------------------------------------------------- #

# 广告与推广 / Ads and promotions
netease.ads = type=http-response,pattern=^https?:\/\/(?:[\w-]+\.)?music\.163\.com\/(?:[a-z]*api)\/(?:ad(?:\/|[?#]|$)|delivery\/|resource-exposure\/|content\/activity\/|vip\/cashier\/|vipmall\/|sp\/flow\/popup\/|mlivestream\/|activity\/),requires-body=1,max-size=-1,binary-body-mode=1,script-path=https://raw.githubusercontent.com/socamalo/netease-music-adblock/main/js/netease-adblock.js,timeout=15

# 首页 / 发现页 / 底部导航 / 侧栏 / 账号中心
# Home, discovery, bottom nav, sidebar, account centre
netease.feeds = type=http-response,pattern=^https?:\/\/(?:[\w-]+\.)?music\.163\.com\/(?:[a-z]*api)\/(?:link\/|homepage\/|v2\/banner\/get|vipnewcenter\/|side-bar\/|yunbei\/|mine\/applet\/|creator\/|moment\/tab\/|user\/sub\/artist|resniche\/),requires-body=1,max-size=-1,binary-body-mode=1,script-path=https://raw.githubusercontent.com/socamalo/netease-music-adblock/main/js/netease-adblock.js,timeout=15

# 搜索页推广 / Search-page promos
netease.search = type=http-response,pattern=^https?:\/\/(?:[\w-]+\.)?music\.163\.com\/(?:[a-z]*api)\/search\/(?:chart|default|rcmd|specialkeyword|suggest),requires-body=1,max-size=-1,binary-body-mode=1,script-path=https://raw.githubusercontent.com/socamalo/netease-music-adblock/main/js/netease-adblock.js,timeout=15

# 评论区插入推广 + /batch 聚合接口 / Comment-area injections + the /batch aggregate
netease.comments = type=http-response,pattern=^https?:\/\/(?:[\w-]+\.)?music\.163\.com\/(?:[a-z]*api)\/(?:batch|v\d\/resource\/comment\/floor\/get|comment\/feed\/inserted|resource\/comments\/musiciansaid|music\/songshare\/|community\/friends\/|v\d\/content\/exposure\/|song\/play\/more\/list\/v\d|ios\/(?:version|upgrade\/get)),requires-body=1,max-size=-1,binary-body-mode=1,script-path=https://raw.githubusercontent.com/socamalo/netease-music-adblock/main/js/netease-adblock.js,timeout=15


[MITM]
# %APPEND% 一定要写：没有它，这个模块会把你配置文件里已有的 hostname 列表整个覆盖掉。
# %APPEND% is required: without it the module overwrites your existing hostname list.
hostname = %APPEND% music.163.com, *.music.163.com
